rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public website can read settings. Only the configured admin UID can write.
    match /publicSettings/{docId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == "REPLACE_WITH_YOUR_FIREBASE_AUTH_UID";
    }
  }
}